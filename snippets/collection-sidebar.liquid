{% comment %}


<div style="overflow: hidden" class=" engoj-collection-sidebar engoc_sw_filter_tag">
  {% for i in (1..7) %}
  {% capture collection_widget %}collection_widget_{{i}}{% endcapture %}
  {% if settings[collection_widget] != blank %}
  {% include settings[collection_widget] %}

  <!-- this is where the list of filering widget would appear -->

  {% endif %}
  {% endfor %}
</div>
<!-- #secondary -->

{% endcomment %}












{% style %}
.filter-group-wrap .filter-title, .filter-title > span{
padding: 6px 0 6px 14px;
border-left: 3px solid {{ settings.color_main }};
position: relative;
font-weight: bold;
}
.filter-group-wrap {
margin-bottom: 1rem;
margin-top: 1rem;
}
.filter-group-wrap span {
font-size: 1.3rem;
}


.filter-group-wrap .filter-title h2 {
{% if settings.font_type == 'google_fonts' %}
font-family: {{ settings.fonts_name_1 }};
{% else %}
font-family: SofiaPro;
{% endif %}
font-size: 15px;
letter-spacing:2px;
font-weight: 500;
text-transform: uppercase;
background: #fff;
position: relative;
display: inline-block;
padding-right: 15px
}

.filter-group-wrap .filter-title:after {
content: "";
border-bottom: 1px solid #e6e6e6;
width: 100%;
position: absolute;
top: 50%
}
ul, ol {
list-style-type: none;
}
.filter-group > summary::-webkit-details-marker {
display: none;
}
summary {
display: block;
cursor: pointer;
}
.filter-group-display {
/* background: #e6e6e666; */
}
.filter-group-display__list {
padding-left: 1rem;
}

/* Hide Checkbox */
.filter-option input[type="checkbox"] {
display: none-off;
}

/* Style for label text when not checked */
.filter-option span {
font-weight: normal;
cursor: pointer;
}

.filter-option input[type="checkbox"] {
position: absolute;
width: 100%;
height: 20px;
z-index: 99;
background: none;
border: none;
opacity: 0;

}
/* Style for label text when checked */
.filter-option input[type="checkbox"]:checked + span {
text-decoration: underline;
font-weight: bold;
}
.filter-option, .filter-option span, .filter-option input {
pointer-events: auto;
}


input[type="checkbox"]:disabled + span {
color: grey; /* Change text color to grey */
opacity: 0.5; /* Makes the text semi-transparent */
}

.active-filters__clear {
padding: 8px;
display: block;
position: relative;
height: auto;
border: 1px solid #e6e6e6;
margin-bottom: 1rem;
width: max-content;
}

.filter_sidebar {
  overflow-x: hidden;
}
@media (min-width: 1000px) {
.filter.d-inline-flex.js_filter {
}
.filter_sortby.d-xl-block {
display: none !important;

}
.collection-page-fullwidth .content-page .shop_control, .collection-page-sidebar .content-page .shop_control {
padding: 20px 0 20px;
}
}

{% endstyle %}








<form class="filter-prod_form engoj-collection-sidebar-off">
  {% comment %}

  <div class="active-filters">
    <a href="{{ collection.url }}?sort_by={{ collection.sort_by }}" class="active-filters__clear">Clear all</a>

    {%- for filter in collection.filters -%}
    {%- if filter.type == "price_range" -%}
    {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
    <a class="active-filters__remove-filter" href="{{ filter.url_to_remove }}">
      {%- assign min_value = filter.min_value.value | default: 0 -%}
      {%- assign max_value = filter.max_value.value | default: filter.range_max -%}
      {{ min_value | money }} - {{ max_value | money }} X
    </a>
    {%- endif -%}
    {%- else -%}
    {%- for filter_value in filter.active_values -%}
    <a class="active-filters__remove-filter" href="{{ filter_value.url_to_remove }}">
      {{ filter.label }}: {{ filter_value.label }} X
    </a>
    {%- endfor -%}
    {%- endif- %}
    {%- endfor -%}
  </div>

  {% endcomment %}

  {%- for filter in collection.filters -%}
  <details class="filter-group" open>
    <summary class="filter-group-wrap">
      <div>
        <span class="filter-title">{{ filter.label }}</span>

        {%- if filter.active_values.size > 0 -%}
        <span>({{ filter.active_values.size }})</span>
        {%- endif -%}
      </div>
    </summary>

    <div class="filter-group-display">

      {% comment %}
      <div class="filter-group-display__header">
        <span class="filter-group-display__header-selected">{{ filter.active_values.size }} selected</span>
        {%- if filter.active_values.size > 0 -%}
        <a href="{{ filter.url_to_remove }}" class="filter-group-display__header-reset">Reset</a>
        {%- endif -%}
      </div>
      {% endcomment %}

      {%- case filter.type -%}
      {%- when 'boolean' or 'list' -%}
      <ul class="filter-group-display__list">
        {%- for filter_value in filter.values -%}
        <li class="filter-group-display__list-item">



          {% comment %}
          <label for="Filter-{{ filter.param_name }}-{{ forloop.index }}">
            <input type="checkbox" name="{{ filter_value.param_name }}" value="{{ filter_value.value }}"
              id="Filter-{{ filter.param_name }}-{{ forloop.index }}" {% if filter_value.active -%}checked{%- endif %}
              {% if filter_value.count == 0 and filter_value.active == false -%}disabled{%- endif %}>{{ filter_value.label }}</label>
          {% endcomment %}

          <label class="filter-option" for="Filter-{{ filter.param_name }}-{{ forloop.index }}">
            <input type="checkbox" name="{{ filter_value.param_name }}" value="{{ filter_value.value }}"
              id="Filter-{{ filter.param_name }}-{{ forloop.index }}" {% if filter_value.active -%}checked{%- endif %}
              {% if filter_value.count == 0 and filter_value.active == false -%}disabled{%- endif %}>
            <span>{{ filter_value.label }}</span>
          </label>



        </li>
        {%- endfor -%}
      </ul>
      {% comment %}
      <div class="filter-group-display__submit">
        <input type="submit" value="Apply">
      </div>
      {% endcomment %}


      {%- when 'price_range' -%}
      <div class="filter-group-display__price-range">
        <div class="filter-group-display__price-range-from">
          <span>{{ cart.currency.symbol }}</span>

          <input name="{{ filter.min_value.param_name }}" id="Filter-{{ filter.min_value.param_name }}"
            {% if filter.min_value.value -%}
            value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" {%- endif %} type="number"
            placeholder="0" min="0" max="{{ filter.range_max | money_without_currency | replace: ',', '' }}">

          <label for="Filter-{{ filter.min_value.param_name }}">From</label>
        </div>
        <div class="filter-group-display__price-range-to">
          <span>{{ cart.currency.symbol }}</span>

          <input name="{{ filter.max_value.param_name }}" id="Filter-{{ filter.max_value.param_name }}"
            {% if filter.max_value.value -%}
            value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" {%- endif %} type="number"
            placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}" min="0"
            max="{{ filter.range_max | money_without_currency | replace: ',', '' }}">

          <label for="Filter-{{ filter.max_value.param_name }}">To</label>
        </div>
      </div>

      <div class="filter-group-display__submit">
        <input type="submit" value="Apply">
      </div>


      {%- endcase -%}
    </div>
  </details>
  {%- endfor -%}


</form>