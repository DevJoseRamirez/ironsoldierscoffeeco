<div data-section-id="{{ section.id }}" data-section-type="section-banner-v5" style="{% if section.settings.margin_top != blank %}margin-top: {{section.settings.margin_top}}px;{% endif %} {% if section.settings.margin_bottom != blank %}margin-bottom: {{section.settings.margin_bottom}}px;{% endif %}">
  <div class="section-banner-v5 {% if section.settings.ena_padding_top %} padding_top_banner5 {% endif %}">
    <div class="{% if section.settings.ena_container %} container container-v2 {% endif %}">
      <div class="row no-gutters align-items-center"  style="background-color:{{ section.settings.bg_banner }}"> 
        <div class=" col-banner-6 {% if section.settings.select_pos == 'left' %} order-lg-1 {% elsif section.settings.select_pos == 'right'%} order-lg-2  {% endif %}">
          <div class="box-img1 img-left" style="background-color:{{ section.settings.bg_banner }}">
            <div class="banner-content">
              {% if section.settings.sub_title_banner != blank %}
              <p class="sub-title" style="color: {{ section.settings.color_sub_title }}">{{ section.settings.sub_title_banner }}</p>
              {% endif %}
              <a href="{{ section.settings.url_banner }}">
                {% if section.settings.title_banner != blank %}
                <h3 class="title-banner" style="color: {{ section.settings.color_title }}">{{ section.settings.title_banner }}</h3>
                {% endif %}
              </a>
            </div>

{% comment %} 
  fa-bolt
  fa-hand-paper-o
  fa-handshake-o
{% endcomment %}

            <div class="banner-content">
              <div class="row">
                <div class="col-sm-6 " style="display: flex; ">
                  <div class="icon">
                    <i class="fa fa-star" aria-hidden="true"></i>
                  </div>
                  <div class="content"> 
                    {% if section.settings.content_title != blank %}
                    <h3 class="subtitle" style="color: {{ section.settings.color_content_title }}">{{ section.settings.content_title }}</h3>
                    {% endif %}
                    {% if section.settings.content_sub != blank %}
                    <p class="subcontent" style="color: {{ section.settings.color_content_sub }}">{{ section.settings.content_sub }}</p>
                    {% endif %}
                  </div>
                </div>

                <div class="col-sm-6 " style="display: flex; ">
                  <div class="icon">
                    <i class="fa fa-hand-paper-o" aria-hidden="true"></i>
                  </div>
                  <div class="content">
                    {% if section.settings.content_title2 != blank %}
                    <h3 class="subtitle" style="color: {{ section.settings.color_content_title }}">{{ section.settings.content_title2 }}</h3>
                    {% endif %}
                    {% if section.settings.content_sub2 != blank %}
                    <p class="subcontent" style="color: {{ section.settings.color_content_sub }}">{{ section.settings.content_sub2 }}</p>
                    {% endif %}
                  </div>
                </div>
              </div>
              <div class="row" style="    margin-top: 40px;">
                <div class="col-sm-6 " style="display: flex; ">
                  <div class="icon">
                    <i class="fa fa-truck" aria-hidden="true"></i>
                  </div>
                  <div class="content">
                    {% if section.settings.content_title3 != blank %}
                    <h3 class="subtitle" style="color: {{ section.settings.color_content_title }}">{{ section.settings.content_title3 }}</h3>
                    {% endif %}
                    {% if section.settings.content_sub3 != blank %}
                    <p class="subcontent" style="color: {{ section.settings.color_content_sub }}">{{ section.settings.content_sub3 }}</p>
                    {% endif %}
                  </div>
                </div>
                <div class="col-sm-6 " style="display: flex;">
                  <div class="icon">
                    <i class="fa fa-bolt" aria-hidden="true"></i>
                  </div>
                  <div class="content">
                    {% if section.settings.content_title4 != blank %}
                    <h3 class="subtitle" style="color: {{ section.settings.color_content_title }}">{{ section.settings.content_title4 }}</h3>
                    {% endif %}
                    {% if section.settings.content_sub4 != blank %}
                    <p class="subcontent" style="color: {{ section.settings.color_content_sub }}">{{ section.settings.content_sub4 }}</p>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class=" col-banner-4 {% if section.settings.select_pos == 'left' %} order-lg-2  {% elsif section.settings.select_pos == 'right'%} order-lg-1 {% endif %}">
          <div class="box-img img-right">
            <a href="{{ section.settings.url_banner }}">
              {% if section.settings.img_banner_right != blank %}
              <img loading="lazy" width="" height="" data-src="{{ section.settings.img_banner_right | image_url }}" class="lazyload img-fluid w-100" alt >
              {% else %}
              <img loading="lazy" width="" height="" data-src="//via.placeholder.com/951x613" class="lazyload img-fluid w-100" alt>
              {% endif %}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .section-banner-v5 .col-banner-6  .img-left .banner-content .button-shop-{{ section.id }} {
    color: {{ section.settings.color_btn }};
    background: {{ section.settings.bg_btn }};
    border: 2px solid  {{ section.settings.bg_btn }};
  }
  .section-banner-v5 .col-banner-6  .img-left .banner-content .button-shop-{{ section.id }}:hover {
    color: {{ section.settings.color_btn_hover }};
    background: transparent;
    border: 2px solid  {{ section.settings.color_btn_hover }};
  }
</style>
