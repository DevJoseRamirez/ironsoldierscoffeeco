{%- style -%}
.video-section-{{ section.id }} {
padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
}

.video-section__container {
max-width: 1200px;
margin: 0 auto;
max-height: 80vh; /* Limit height to 80% of viewport height */
display: flex;
flex-direction: column;
}

.video-section__video-wrapper {
position: relative;
width: 100%;
height: 0;
padding-bottom: 56.25%; /* 16:9 aspect ratio */
max-height: calc(80vh - 40px); /* Subtract some space for potential heading */
overflow: hidden;
}

.video-section__video {
position: absolute;
top: 0;
left: 0;
width: 100%;
height: 100%;
}

.video-section__video video {
width: 100%;
height: 100%;
object-fit: cover;
cursor: pointer;
}

.video-section__overlay {
position: absolute;
top: 0;
left: 0;
width: 100%;
height: 100%;
background-color: rgba(0, 0, 0, 0.3);
pointer-events: none;
}

.video-section__play-button {
position: absolute;
top: 50%;
left: 50%;
transform: translate(-50%, -50%);
background: rgba(0, 0, 0, 0.7);
border: none;
border-radius: 50%;
width: clamp(40px, 8vw, 80px); /* Slightly smaller */
height: clamp(40px, 8vw, 80px); /* Slightly smaller */
cursor: pointer;
display: flex;
justify-content: center;
align-items: center;
z-index: 2;
transition: opacity 0.3s ease, transform 0.3s ease;
}

.video-section__play-button:hover {
opacity: 0.8;
transform: translate(-50%, -50%) scale(1.1);
}

.video-section__play-button svg {
width: clamp(15px, 3vw, 30px); /* Slightly smaller */
height: clamp(15px, 3vw, 30px); /* Slightly smaller */
fill: #ffffff;
}

.video-section__play-button .icon-pause {
width: clamp(15px, 3vw, 30px); /* Slightly smaller */
height: clamp(15px, 3vw, 30px); /* Slightly smaller */
fill: #ffffff;
}

@media screen and (min-width: 750px) {
.video-section-{{ section.id }} {
padding-top: {{ section.settings.padding_top }}px;
padding-bottom: {{ section.settings.padding_bottom }}px;
}
}

@media screen and (max-height: 600px) {
.video-section__container {
max-height: 90vh; /* Increase max height for very short screens */
}

.video-section__video-wrapper {
max-height: calc(90vh - 20px);
}
}
{%- endstyle -%}



<div class="video-section-{{ section.id }}">
    <div class="video-section__container">
        {%- if section.settings.heading != blank -%}
        <h2 class="video-section__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.video != blank -%}
        <div class="video-section__video-wrapper">
            <div class="video-section__video" id="video-{{ section.id }}">
                {{ section.settings.video | video_tag: image_size: '1100x', autoplay: true, muted: true, loop: true, playsinline: true, controls: false }}
            </div>
            <div class="video-section__overlay" id="overlay-{{ section.id }}"></div>
            <button class="video-section__play-button" id="play-button-{{ section.id }}" aria-label="Play/Pause video">
                <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class="icon icon-play"
                    fill="none" viewBox="0 0 10 14">
                    <path fill-rule="evenodd" clip-rule="evenodd"
                        d="M1.48177 0.814643C0.81532 0.448245 0 0.930414 0 1.69094V12.2081C0 12.991 0.858787 13.4702 1.52503 13.0592L10.5398 7.49813C11.1918 7.09588 11.1679 6.13985 10.4965 5.77075L1.48177 0.814643Z"
                        fill="currentColor" />
                </svg>
            </button>
        </div>
        {%- endif -%}
    </div>
</div>



<script>
    document.addEventListener('DOMContentLoaded', function () {
        var videoWrapper = document.querySelector('#video-{{ section.id }}');
        var video = videoWrapper.querySelector('video');
        var playButton = document.getElementById('play-button-{{ section.id }}');
        var overlay = document.getElementById('overlay-{{ section.id }}');
        var isBackgroundPlay = true;
        var hasPlayedOnce = false;

        if (video && playButton && overlay) {
            function updateButton() {
                if (isBackgroundPlay) {
                    playButton.style.display = 'flex';
                    overlay.style.display = 'block';
                    playButton.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class="icon icon-play" fill="none" viewBox="0 0 10 14"><path fill-rule="evenodd" clip-rule="evenodd" d="M1.48177 0.814643C0.81532 0.448245 0 0.930414 0 1.69094V12.2081C0 12.991 0.858787 13.4702 1.52503 13.0592L10.5398 7.49813C11.1918 7.09588 11.1679 6.13985 10.4965 5.77075L1.48177 0.814643Z" fill="currentColor" /></svg>';
                } else if (video.paused && hasPlayedOnce) {
                    playButton.style.display = 'flex';
                    overlay.style.display = 'block'; // Reapply overlay when paused
                    playButton.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class="icon icon-pause" fill="none" viewBox="0 0 12 14"><path fill-rule="evenodd" clip-rule="evenodd" d="M0 1C0 0.447715 0.447715 0 1 0H3C3.55228 0 4 0.447715 4 1V13C4 13.5523 3.55228 14 3 14H1C0.447715 14 0 13.5523 0 13V1ZM8 1C8 0.447715 8.44772 0 9 0H11C11.5523 0 12 0.447715 12 1V13C12 13.5523 11.5523 14 11 14H9C8.44772 14 8 13.5523 8 13V1Z" fill="currentColor"/></svg>';
                } else {
                    playButton.style.display = 'none';
                    overlay.style.display = 'none';
                }
            }

            function togglePlayPause() {
                if (isBackgroundPlay) {
                    video.currentTime = 0;
                    video.muted = false;
                    video.loop = false;
                    video.play();
                    isBackgroundPlay = false;
                    hasPlayedOnce = true;
                } else if (video.paused) {
                    video.play();
                } else {
                    video.pause();
                }
                updateButton();
            }

            playButton.addEventListener('click', togglePlayPause);
            video.addEventListener('click', togglePlayPause);

            video.addEventListener('pause', updateButton);
            video.addEventListener('play', updateButton);

            // Initial state
            updateButton();
        }
    });
</script>





{% schema %}
{
"name": "Video",
"tag": "section",
"class": "section",
"settings": [
{
"type": "text",
"id": "heading",
"label": "Heading"
},
{
"type": "video",
"id": "video",
"label": "Video"
},
{
"type": "checkbox",
"id": "enable_video_looping",
"label": "Enable video looping",
"default": false
},
{
"type": "range",
"id": "padding_top",
"min": 0,
"max": 100,
"step": 4,
"unit": "px",
"label": "Top padding",
"default": 36
},
{
"type": "range",
"id": "padding_bottom",
"min": 0,
"max": 100,
"step": 4,
"unit": "px",
"label": "Bottom padding",
"default": 36
}
],
"presets": [
{
"name": "Video"
}
]
}
{% endschema %}