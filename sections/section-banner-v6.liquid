      "info": "Defined in pixels. Do not add the 'px' unit."
    },
    {
      "type": "header",
      "content": "Background Color Banner"
    },
    {
      "type": "header",
      "content": "Settings Banner Content"
    },
    {
      "type": "text",
      "id": "title_banner",
      "label": "Title Banner 1",
      "default": "100% Pure Natural Vegetables"
    },
    {
      "type": "text",
      "id": "title_banner2",
      "label": "Title Banner 2",
      "default": "100% Pure Natural Vegetables "
    },
    {
      "type": "color",
      "id": "color_title",
      "label": "Color Title banner",
      "default": "#fff"
    },
    {
      "type": "text",
      "id": "sub_title_banner",
      "label": "Sub Title Banner",
      "default": "NEW ARRIVAL"
    },
    {
      "type": "text",
      "id": "sub_title_banner2",
      "label": "Sub Title Banner 2",
      "default": "NEW ARRIVAL"
    },
    {
      "type": "color",
      "id": "color_sub_title",
      "label": "Color Sub Title banner",
