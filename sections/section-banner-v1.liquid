<div data-section-id="{{ section.id }}" data-section-type="section-banner-v1" style="{% if section.settings.margin_top != blank %}margin-top: {{section.settings.margin_top}}px;{% endif %} {% if section.settings.margin_bottom != blank %}margin-bottom: {{section.settings.margin_bottom}}px;{% endif %}">
  <div class="section-banner-v1 lazyload" {% if section.settings.ena_background_img %} {% if section.settings.bg_image != blank %} data-bg="{{ section.settings.bg_image | image_url }}"  style=" background-attachment: fixed;" {% endif %} {% else %} style="background-color : {{ section.settings.bg_color }}" {% endif %}  >
    <div class="container container-v1">
      <div class="row">
        <div class="col-md-6">
          <div class="banner">
            <div class="box-img">
              <a href="{{ section.settings.url_banner }}">
                {% if section.settings.img_banner != blank %}
                <img loading="lazy" width="" height="" data-src="{{ section.settings.img_banner | image_url }}" class="lazyload img-fluid w-100" alt >
                {% else %}
                <img loading="lazy" width="" height="" data-src="//via.placeholder.com/810x560" class="lazyload img-fluid w-100" alt>
                {% endif %}
              </a>
            </div>
            <div class="button ">
              {% if section.settings.button_banner != blank %}
              <a href="{{ section.settings.url_banner }}" class="button-shop button-shop-{{ section.id }}" title="">{{ section.settings.button_banner }}</a>
              {% endif %}
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="row banner-weght">
            <div class="col-sm-6">
              <div class="banner">
                <div class="box-img">
                  <a href="{{ section.settings.url_banner }}">
                    {% if section.settings.img_banner2 != blank %}
                    <img loading="lazy" width="" height="" data-src="{{ section.settings.img_banner2 | image_url }}" class="lazyload img-fluid w-100" alt >
                    {% else %}
                    <img loading="lazy" width="" height="" data-src="//via.placeholder.com/383x260" class="lazyload img-fluid w-100" alt>
                    {% endif %}
                  </a>
                </div>
                <div class="button ">
                  {% if section.settings.button_banner2 != blank %}
                  <a href="{{ section.settings.url_banner }}" class="button-shop button-shop-{{ section.id }}" title="">{{ section.settings.button_banner2 }}</a>
                  {% endif %}
                </div>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="banner">
                <div class="box-img">
                  <a href="{{ section.settings.url_banner }}">
                    {% if section.settings.img_banner3 != blank %}
                    <img loading="lazy" width="" height="" data-src="{{ section.settings.img_banner3 | image_url }}" class="lazyload img-fluid w-100" alt >
                    {% else %}
                    <img loading="lazy" width="" height="" data-src="//via.placeholder.com/383x260" class="lazyload img-fluid w-100" alt>
                    {% endif %}
                  </a>
                </div>
                <div class="button ">
                  {% if section.settings.button_banner3 != blank %}
                  <a href="{{ section.settings.url_banner }}" class="button-shop button-shop-{{ section.id }}" title="">{{ section.settings.button_banner3 }}</a>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
          <div class="row ">
            <div class="col-sm-6">
              <div class="banner">
                <div class="box-img">
                  <a href="{{ section.settings.url_banner }}">
                    {% if section.settings.img_banner4 != blank %}
                    <img loading="lazy" width="" height="" data-src="{{ section.settings.img_banner4 | image_url }}" class="lazyload img-fluid w-100" alt >
                    {% else %}
                    <img loading="lazy" width="" height="" data-src="//via.placeholder.com/383x260" class="lazyload img-fluid w-100" alt>
                    {% endif %}
                  </a>
                </div>
                <div class="button ">
                  {% if section.settings.button_banner4 != blank %}
                  <a href="{{ section.settings.url_banner }}" class="button-shop button-shop-{{ section.id }}" title="">{{ section.settings.button_banner4 }}</a>
                  {% endif %}
                </div>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="banner">
                <div class="box-img">
                  <a href="{{ section.settings.url_banner }}">
                    {% if section.settings.img_banner5 != blank %}
                    <img loading="lazy" width="" height="" data-src="{{ section.settings.img_banner5 | image_url }}" class="lazyload img-fluid w-100" alt >
                    {% else %}
                    <img loading="lazy" width="" height="" data-src="//via.placeholder.com/383x260" class="lazyload img-fluid w-100" alt>
                    {% endif %}
                  </a>
                </div>
                <div class="button ">
                  {% if section.settings.button_banner5 != blank %}
                  <a href="{{ section.settings.url_banner }}" class="button-shop button-shop-{{ section.id }}" title="">{{ section.settings.button_banner5 }}</a>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<style>

  .section-banner-v1 .button .button-shop-{{ section.id }} {
    color: {{ section.settings.color_btn }};
    border: 1px solid {{ section.settings.color_btn }};
  }
 .section-banner-v1 .banner:hover .button .button-shop-{{ section.id }} {
    color: {{ section.settings.color_btn_hover }};
    border: 1px solid {{ section.settings.bg_btn_hover }};
    background: {{ section.settings.bg_btn_hover }};
  }
</style>

{% schema %}
{
  "name": "BANNER V1",
  "settings": [
    {
      "type": "header",
      "content": "Section Space"
    },
    {
      "type": "text",
      "id": "margin_top",
      "label": "Margin Top",
      "info": "Defined in pixels. Do not add the 'px' unit."
    },
    {
      "type": "text",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "info": "Defined in pixels. Do not add the 'px' unit."
