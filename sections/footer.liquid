<!-- /sections/footer.liquid -->
{% if template contains 'index' %}
  {% if section.settings.select_fts == "footer_v1" %}
  {% include 'footer-v1' %}
  {% elsif section.settings.select_fts == "footer_v2" %}
  {% include 'footer-v2' %}
  {% elsif section.settings.select_fts == "footer_v3" %}
  {% include 'footer-v3' %}
  {% elsif section.settings.select_fts == "footer_v4" %}
  {% include 'footer-v4' %}
  {% elsif section.settings.select_fts == "footer_v5" %}
  {% include 'footer-v5' %}
  {% elsif section.settings.select_fts == "footer_v6" %}
  {% include 'footer-v6' %}
  {% elsif section.settings.select_fts == "footer_none" %}
  {% endif %}

  
{% else %}
  {% if section.settings.select_fts_all == "footer_ver1" %}
  {% include 'footer-v1' %}
  {% elsif section.settings.select_fts_all == "footer_ver2" %}
  {% include 'footer-v2' %}
  {% elsif section.settings.select_fts_all == "footer_ver3" %}
  {% include 'footer-v3' %}
  {% elsif section.settings.select_fts_all == "footer_ver4" %}
  {% include 'footer-v4' %}
  {% elsif section.settings.select_fts_all == "footer_ver5" %}
  {% include 'footer-v5' %}
  {% elsif section.settings.select_fts_all == "footer_ver6" %}
  {% include 'footer-v6' %}
  {% endif %}

{% endif %}

{% schema %}
{
  "name": "Footer",
  "class": "index-section",
  "settings": [
    {
      "type": "header",
      "content": "Footer Homepage"
    },
    {
      "type": "select",
      "id": "select_fts",
      "label": "Select Style",
      "options": [
        {
          "value": "footer_v1",
          "label": "Footer v1"
        },
        {
          "value": "footer_v2",
          "label": "Footer v2"
        },
        {
          "value": "footer_v3",
          "label": "Footer v3"
        },
        {
          "value": "footer_v4",
          "label": "Footer v4"
        },
        {
          "value": "footer_v5",
          "label": "Footer v5"
        },
        {
          "value": "footer_v6",
          "label": "Footer v6"
        },
        {
          "value": "footer_none",
          "label": "No Footer"
        }
      ],
      "default": "footer_v1"
    },
    {
      "type": "color",
      "id": "ft_home_bg_footer",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "ft_home_color_text",
      "label": "Texts, Icons Color",
      "default": "#fff"
    },
    {
      "type": "header",
      "content": "Footer OtherPages"
    },
    {
      "type": "select",
      "id": "select_fts_all",
      "label": "Select Footer Style for All page (unless Homepage)",
      "options": [
        {
          "value": "footer_ver1",
          "label": "Footer v1"
        },
        {
          "value": "footer_ver2",
          "label": "Footer v2"
        },
        {
          "value": "footer_ver3",
          "label": "Footer v3"
        },
        {
          "value": "footer_ver4",
          "label": "Footer v4"
        },
        {
          "value": "footer_ver5",
          "label": "Footer v5"
        },
        {
          "value": "footer_ver6",
          "label": "Footer v6"
        }
      ],
      "default": "footer_ver1"
    },
    {
      "type": "color",
      "id": "ft_other_bg_footer",
      "label": "Background Color"
    },
    {
      "type": "color",
      "id": "ft_other_color_text",
      "label": "Texts, Icons Color",
      "default": "#fff"
    },
    {
      "type": "header",
      "content": "CWC Press Logos"
    },
    {
      "type": "checkbox",
      "id": "ft_press_enable",
      "label": "Show Press Logos Row",
      "default": true
    },
    {
      "type": "text",
      "id": "ft_press_label",
      "label": "Label",
      "default": "As Featured On"
    },
    {
      "type": "select",
      "id": "ft_press_style",
      "label": "Logo Style",
      "options": [
        { "value": "white", "label": "White (dark footer)" },
        { "value": "color", "label": "Color (light footer)" }
      ],
      "default": "white"
    },
    {
      "type": "range",
      "id": "ft_press_height",
      "label": "Logo Height",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "ft_press_gap",
      "label": "Space Between Logos (Desktop)",
      "info": "Mobile spacing stays fixed.",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "ft_press_fox",
      "label": "Show FOX",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "ft_press_nbc",
      "label": "Show NBC",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "ft_press_cbs",
      "label": "Show CBS",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "ft_press_cw",
      "label": "Show The CW",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "ft_press_abc",
      "label": "Show ABC",
      "default": true
    }
  ]
}
{% endschema %}