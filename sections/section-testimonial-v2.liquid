<div data-section-id="{{ section.id }}" data-section-type="section-testimonial-v1" style="{% if section.settings.margin_top != blank %}margin-top: {{section.settings.margin_top}}px;{% endif %} {% if section.settings.margin_bottom != blank %}margin-bottom: {{section.settings.margin_bottom}}px;{% endif %}">
  <div class="section-testimonial-v2 mt-all" style="background:{{ section.settings.bg_color }}">
    <div class="container container-v2">
      {% if section.settings.section_title != blank %}
        <div class=" text-center" >
          <h3 class="title_heading">{{ section.settings.section_title }}</h3>
        </div>
        {% endif %}

      <div class="row js-testimonial-v2-slide testimonial-content">
        {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
        {% if block.type == "testimonial" %}
        <div class="col-12">
          <div class="testimonial-inner">
            <div class="thumb">
              <figure>
                {% if block.settings.author_img != blank %}
                <img loading="lazy" width="" height="" src="{{ block.settings.author_img | image_url }}" class="img-responsive" alt="banner">
                {% else %}
                <img loading="lazy" width="" height="" src="//via.placeholder.com/100x100">
                {% endif %}
              </figure>
            </div>
            <div class="testimonial-wrap">
              <h3 class="name"> <a href="{{ block.settings.testi_name_url }}" target=" _blank">{{block.settings.testi_name}}</a></h3>
              <div class="position">{{ block.settings.testi_info }}</div>
              <p class="desc">{{ block.settings.testi_content }}</p>
              <div class="rating rating-{{ block.settings.testi_rate }}"><span></span></div>
            </div>
          </div>
        </div>
        {% endif %}
        {% endfor %}
        {% endif %}
        
      </div>
      
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TESTIMONIAL V2",
  "class": "index-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f5f5"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Title",
      "default": "TESTIMONIALS"
    },
    {
      "type": "header",
      "content": "Section Space"
    },
    {
      "type": "text",
      "id": "margin_top",
      "label": "Margin Top",
      "info": "Defined in pixels. Do not add the 'px' unit."
    },
    {
      "type": "text",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "info": "Defined in pixels. Do not add the 'px' unit."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "testi_rate",
          "label": "Rating stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "testi_content",
          "label": "Content",
          "default": "OEM direct replacement, fits perfectly only steering pump. Brought my car up to spec again.."
        },
        {
          "type": "image_picker",
          "id": "author_img",
          "label": "Author image",
          "info": "100 x 100px recommended"
        },
        {
          "type": "text",
          "id": "testi_name",
          "label": "Name",
          "default": "Rein® PSR0022"
        },
        {
          "type": "url",
          "id": "testi_name_url",
          "label": "URL Name",
          "default": "/collections/all"
        },
        {
          "type": "text",
          "id": "testi_info",
          "label": "Info",
          "default": "Power Steering Reservoir"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TESTIMONIAL V2",
      "category": "HOME",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}

