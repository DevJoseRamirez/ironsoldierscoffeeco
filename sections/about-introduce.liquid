{% comment %} CWC: editable intro text color (theme default was light gray #969696) {% endcomment %}
{% style %}
  #shopify-section-{{ section.id }} .aboutus-pages .about-introduce .intro_detail .info-intro .content_intro p,
  #shopify-section-{{ section.id }} .aboutus-pages .about-introduce .intro_detail .info-intro .des_intro {
    color: {{ section.settings.text_color | default: '#222222' }};
  }
  #shopify-section-{{ section.id }} .aboutus-pages .about-introduce .intro_detail .info-intro .content_intro p {
    font-size: {{ section.settings.body_font_size | default: 18 }}px;
  }
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .aboutus-pages .about-introduce .intro_detail .info-intro .content_intro p {
      font-size: {{ section.settings.body_font_size | default: 18 | times: 0.9 | round }}px;
    }
  }
{% endstyle %}

<div class="aboutus-pages">
{% if section.settings.enable_intro %}
    <div class="container container-v4">  
	<div class="about-introduce">
        {% for block in section.blocks %}
        {% if block.type == 'introduce' %}
        {% assign mod = forloop.index | modulo: 2 %}
        {% if mod == 1 %}
        <div class="row">
          <div class="col-md-6 intro_detail d-flex align-items-center order-md-1 order-2">
            <div class="info-intro ">
              <h3 class="title_intro">{{ block.settings.title_intro }}</h3>
              <p class="des_intro">{{ block.settings.des_intro }}</p>

              <div class="content_intro">{{ block.settings.content_intro }}</div>
            </div>
          </div>
          <div class="col-md-6 intro_image order-md-2 order-1">
            <img loading="lazy" width="" height="" class="w-100" src="{% if block.settings.image_intro != blank %} {{ block.settings.image_intro | image_url }} {% else %}//via.placeholder.com/660x600{% endif %}">
          </div>
        </div>          
        {% else %}

        <div class="row">
          <div class="col-md-6 intro_image">
            <img loading="lazy" width="" height="" class="w-100" src="{% if block.settings.image_intro != blank %} {{ block.settings.image_intro | image_url }} {% else %}//via.placeholder.com/660x600{% endif %}">
          </div>
          <div class="col-md-6 intro_detail d-flex align-items-center">
            <div class="info-intro">
              <h3 class="title_intro">{{ block.settings.title_intro }}</h3>
              <p class="des_intro">{{ block.settings.des_intro }}</p>

              <div class="content_intro">{{ block.settings.content_intro }}</div>
            </div>
          </div>
        </div>
        {% endif %}
        {% endif %}
        {% endfor %}
      </div>
</div>
      {% endif %}
</div>
{% schema %}
{
  "name": "About Introduce",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_intro",
      "label": "Enable",
      "default": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "info": "Subtitle and body text color.",
      "default": "#222222"
    },
    {
      "type": "range",
      "id": "body_font_size",
      "label": "Body Text Size",
      "info": "Mobile uses about 90% of this size.",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 18
    }
  ],
  "blocks": [
    {
      "type": "introduce",
      "name": "Introduce",
      "settings": [
        {
          "type": "image_picker",
          "id": "image_intro",
          "label": "Image Introduce",
          "info": "670x600px recommended"
        },
        {
          "type": "text",
          "id": "title_intro",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "des_intro",
          "label": "Description"
        },
        {
          "type": "html",
          "id": "content_intro",
          "label": "Content"
        }
      ]
    }
  ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}
