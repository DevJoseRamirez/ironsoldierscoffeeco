{% style %}
  #CWC_three_image_banner-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#111111' }};
    --padding-top: {{ section.settings.padding_top | default: 0 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
  }
{% endstyle %}

{{ 'CWC_three_image_banner.css' | asset_url | stylesheet_tag }}

<section
  id="CWC_three_image_banner-{{ section.id }}"
  class="cwc-three-image-banner"
>
  <div class="cwc-three-image-banner__grid">
    {% for i in (1..3) %}
      {% assign img_key        = 'banner_' | append: i | append: '_image' %}
      {% assign img_mobile_key = 'banner_' | append: i | append: '_image_mobile' %}
      {% assign link_key       = 'banner_' | append: i | append: '_link' %}
      {% assign img            = section.settings[img_key] %}
      {% assign img_mobile     = section.settings[img_mobile_key] %}
      {% assign link           = section.settings[link_key] %}

      {% if img != blank %}
        <a
          class="cwc-three-image-banner__banner cwc-three-image-banner__banner--{{ i }}"
          {% if link != blank %}href="{{ link }}"{% endif %}
        >
          <div class="cwc-three-image-banner__image-wrap cwc-three-image-banner__image-wrap--desktop">
            {{ img | image_url: width: 1400 | image_tag:
              loading: 'lazy',
              class: 'cwc-three-image-banner__image',
              alt: ''
            }}
          </div>

          <div class="cwc-three-image-banner__image-wrap cwc-three-image-banner__image-wrap--mobile">
            {% if img_mobile != blank %}
              {{ img_mobile | image_url: width: 800 | image_tag:
                loading: 'lazy',
                class: 'cwc-three-image-banner__image',
                alt: ''
              }}
            {% else %}
              {{ img | image_url: width: 800 | image_tag:
                loading: 'lazy',
                class: 'cwc-three-image-banner__image',
                alt: ''
              }}
            {% endif %}
          </div>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Three Image Banner",
  "settings": [
    {
      "type": "header",
      "content": "Banner 1"
    },
    {
      "type": "image_picker",
      "id": "banner_1_image",
      "label": "Banner 1 — Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "banner_1_image_mobile",
      "label": "Banner 1 — Mobile Image"
    },
    {
      "type": "url",
      "id": "banner_1_link",
      "label": "Banner 1 — Link"
    },
    {
      "type": "header",
      "content": "Banner 2"
    },
    {
      "type": "image_picker",
      "id": "banner_2_image",
      "label": "Banner 2 — Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "banner_2_image_mobile",
      "label": "Banner 2 — Mobile Image"
    },
    {
      "type": "url",
      "id": "banner_2_link",
      "label": "Banner 2 — Link"
    },
    {
      "type": "header",
      "content": "Banner 3"
    },
    {
      "type": "image_picker",
      "id": "banner_3_image",
      "label": "Banner 3 — Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "banner_3_image_mobile",
      "label": "Banner 3 — Mobile Image"
    },
    {
      "type": "url",
      "id": "banner_3_link",
      "label": "Banner 3 — Link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Three Image Banner",
      "category": "CWC Custom"
    }
  ]
}
{% endschema %}
