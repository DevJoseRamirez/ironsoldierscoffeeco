{% style %}
  #CWC_two_image_banner-{{ section.id }} {
    --section-bg: {{ section.settings.background_color }};
    --text-color: {{ section.settings.text_color }};
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --padding-top-mobile: {{ section.settings.padding_top | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_two_image_banner.css' | asset_url | stylesheet_tag }}

<section id="CWC_two_image_banner-{{ section.id }}" class="CWC_two_image_banner">
  <div class="CWC_two_image_banner-wrapper">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'image_block' %}
          <div
            class="CWC_two_image_banner-column"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="CWC_two_image_banner-link">
            {% endif %}

            {% if block.settings.mobile_image != blank and block.settings.mobile_image != blank %}
              <picture>
                <source media="(max-width: 767px)" srcset="{{ block.settings.mobile_image | image_url }}">
                <img
                  loading="eager"
                  fetchpriority="high"
                  src="{{ block.settings.desktop_image | image_url }}"
                  alt="{{ block.settings.alt_text | default: block.settings.desktop_image.alt }}"
                  width="{{ block.settings.desktop_image.width }}"
                  height="{{ block.settings.desktop_image.height }}"
                  class="CWC_two_image_banner-image"
                >
              </picture>
            {% elsif block.settings.desktop_image != blank %}
              <img
                loading="eager"
                fetchpriority="high"
                src="{{ block.settings.desktop_image | image_url }}"
                alt="{{ block.settings.alt_text | default: block.settings.desktop_image.alt }}"
                width="{{ block.settings.desktop_image.width }}"
                height="{{ block.settings.desktop_image.height }}"
                class="CWC_two_image_banner-image"
              >
            {% else %}
              <img
                loading="lazy"
                fetchpriority="low"
                src="{{ 'placeholder.png' | asset_url }}"
                alt="Placeholder image"
                width="100%"
                height="100%"
                class="CWC_two_image_banner-image"
              >
            {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </div>
      {% endcase %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "CWC Two Image Banner",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FAF9F6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#202020"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "max_blocks": 2,
  "blocks": [
    {
      "type": "image_block",
      "name": "Image Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile Image (Optional)"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Image Alt Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Two Image Banner",
      "category": "Custom",
      "blocks": [
        {
          "type": "image_block"
        },
        {
          "type": "image_block"
        }
      ]
    }
  ]
}
{% endschema %}
