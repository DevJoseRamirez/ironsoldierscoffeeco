<div data-section-id="{{ section.id }}" data-section-type="section-banner-v12" style="{% if section.settings.margin_top != blank %}margin-top: {{section.settings.margin_top}}px;{% endif %} {% if section.settings.margin_bottom != blank %}margin-bottom: {{section.settings.margin_bottom}}px;{% endif %}">
  <div class="section-banner-v12 mt-all"> 
    <div class="container container-v2">
      <div class="row "  style="background-color:{{ section.settings.bg_banner }}"> 
        <div class="col-md-4"> 
          <div class="banner">
            <div class="img-banner">
              <img loading="lazy" width="" height="" data-src="{% if section.settings.img_banner1 != blank %} {{ section.settings.img_banner1 | image_url }} {% else %} //via.placeholder.com/449x308 {% endif %}" class="lazyload w-100 img-fluid">
            </div>
            <div class="content-banner">
              {% if section.settings.sub_heading1 != blank %}
              <p class="sub-heading" style="color: {{ section.settings.color_sub_heading }}">{{ section.settings.sub_heading1 }}</p>
              {% endif %}
              <a href="{{ section.settings.url_banner }}">
                {% if section.settings.title_banner1 != blank %}
                <h3 class="title-banner title-banner-{{ section.id }} ">{{ section.settings.title_banner1 }}</h3>
                {% endif %}
              </a>
                {% if section.settings.sub_bottom1 != blank %}
                <p class="sub-banner-bottom" style="color: {{ section.settings.color_sub_bottom }}">{{ section.settings.sub_bottom1 }}</p>
                {% endif %}
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="banner">
            <div class="img-banner">
              <img loading="lazy" width="" height="" data-src="{% if section.settings.img_banner2 != blank %} {{ section.settings.img_banner2 | image_url }} {% else %} //via.placeholder.com/449x308 {% endif %}" class="lazyload w-100 img-fluid">
            </div>
            <div class="content-banner">
              {% if section.settings.sub_heading2 != blank %}
              <p class="sub-heading" style="color: {{ section.settings.color_sub_heading }}">{{ section.settings.sub_heading2 }}</p>
              {% endif %}
              <a href="{{ section.settings.url_banner }}">
                {% if section.settings.title_banner2 != blank %}
                <h3 class="title-banner title-banner-{{ section.id }}">{{ section.settings.title_banner2 }}</h3>
                {% endif %}
              </a>
              {% if section.settings.sub_bottom2 != blank %}
              <p class="sub-banner-bottom" style="color: {{ section.settings.color_sub_bottom }}">{{ section.settings.sub_bottom2 }}</p>
              {% endif %}
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="banner">
            <div class="img-banner">
              <img loading="lazy" width="" height="" data-src="{% if section.settings.img_banner3 != blank %} {{ section.settings.img_banner3 | image_url }} {% else %} //via.placeholder.com/449x308 {% endif %}" class="lazyload w-100 img-fluid">
            </div>
            <div class="content-banner">
              {% if section.settings.sub_heading3 != blank %}
              <p class="sub-heading" style="color: {{ section.settings.color_sub_heading }}">{{ section.settings.sub_heading3 }}</p>
              {% endif %}
              <a href="{{ section.settings.url_banner }}">
                {% if section.settings.title_banner3 != blank %}
                <h3 class="title-banner title-banner-{{ section.id }}">{{ section.settings.title_banner3 }}</h3>
                {% endif %}
              </a>
              {% if section.settings.sub_bottom3 != blank %}
              <p class="sub-banner-bottom" style="color: {{ section.settings.color_sub_bottom }}">{{ section.settings.sub_bottom3 }}</p>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .section-banner-v12 .content-banner .title-banner-{{ section.id }} {
    color: {{ section.settings.color_title_banner }};
transition: all .3s;
  }
  .section-banner-v12 .content-banner .title-banner-{{ section.id }}:hover {
    color: {{ section.settings.color_title_hover_banner }};
  }
</style>
