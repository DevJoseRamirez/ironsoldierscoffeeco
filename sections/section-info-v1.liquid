{% style %}
.section-info-v1-wrap {
margin-top: {{section.settings.margin_top}}px;
margin-bottom: {{section.settings.margin_bottom}}px;
margin: 2rem 0rem;
}
.section-info-v1 {
/* margin-top: {{section.settings.margin_top}}px; */
/* margin-bottom: {{section.settings.margin_bottom}}px; */
}
{% endstyle %}


<div data-section-id="{{ section.id }}" data-section-type="" class="section-info-v1-wrap">
  <div class="section-info-v1">
    <div class="container container-v2">
      <div class="d-flex justify-content-center">
        {% if section.settings.title_info != blank %}
        <div class="title-info text-center">
          <h2 class="title_heading mb-0" style="color: {{ section.settings.color_title_info }}">{{
            section.settings.title_info }}</h2>
        </div>
        {% endif %}
      </div>
      {% if section.settings.content_info != blank %}
      <p class="content_info" style="color: {{ section.settings.color_content_info }}">{{ section.settings.content_info
        }}</p>
      {% endif %}
      {% if section.settings.more_about != blank %}
      <div class="row justify-content-center button-about">
        <a class="" href="{{ section.settings.url_banner }}">{{ section.settings.more_about }}</a>
      </div>
      {% endif %}
    </div>
  </div>
</div>



{% schema %}
{
"name": "INFO V1",
"settings": [
{
"type": "text",
"id": "title_info",
"label": "Title info",
"default": "Surprising Health <br>Benefits Of Green Tea"
},
{
"type": "color",
"id": "color_title_info",
"label": "Color Title info"
},
{
"type": "text",
"id": "content_info",
"label": "Content info",
"default": "Green tеа iѕ rich in antioxidant substances called polyphenol: A series оf chemicals called catechins; EGCG"
},
{
"type": "color",
"id": "color_content_info",
"label": "Color Content info"
},
{
"type": "text",
"id": "more_about",
"label": "button",
"default": "More about us"
},
{
"type": "url",
"id": "url_banner",
"label": "URL button",
"default": "/collections/all"
},
{
"type": "header",
"content": "Section Space"
},
{
"type": "text",
"id": "margin_top",
"label": "Margin Top",
"info": "Defined in pixels. Do not add the 'px' unit."
},
{
"type": "text",
"id": "margin_bottom",
"label": "Margin Bottom",
"info": "Defined in pixels. Do not add the 'px' unit."
}
],
"presets": [
{
"name": "INFO V1",
"category": "HOME"
}
]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

