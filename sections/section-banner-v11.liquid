<div data-section-id="{{ section.id }}" data-section-type="section-banner-v11" style="{% if section.settings.margin_top != blank %}margin-top: {{section.settings.margin_top}}px;{% endif %} {% if section.settings.margin_bottom != blank %}margin-bottom: {{section.settings.margin_bottom}}px;{% endif %}">
  <div class="section-banner-v11 mt-all" style="background: {{ section.settings.bg_section }}">
    <div class="container container-v2 ">
      <div class="row" style="align-items: center;">   
        <div class="col-xl-7 col-md-6  p-0">
          <div class="img-banner text-center">
            <a href="{{ section.settings.url_banner }}">
              {% if section.settings.img_banner != blank %}
              <img loading="lazy" width="" height="" data-src="{{ section.settings.img_banner | image_url }}" class="lazyload img-fluid " alt >
              {% else %}
              <img loading="lazy" width="" height="" data-src="//via.placeholder.com/535x534" class="lazyload img-fluid " alt>
              {% endif %}
            </a>
          </div>
        </div>
        <div class="col-xl-5 col-md-6 " >
          <div class="content-banner ">
            {% if section.settings.title_banner != blank %}
            <h1 class="title-banner" style="color: {{ section.settings.color_title }}">{{ section.settings.title_banner }}</h1>
            {% endif %}
          </div>
          <div class="col-inner">
            <ul class="p-0" style="list-style: none;">
              {% if section.blocks.size > 0 %}
              {% for block in section.blocks %}
              {% if block.type == 'colection' %}

              {% if block.settings.block_title_small != blank %}
              <li class="title-small" style="color: {{ block.settings.color_title_small }}">{{ block.settings.block_title_small }}</li>
              {% endif %}
              {% endif %}
              {% endfor %}
              {% endif %} 

            </ul>
          </div>
          <div class="button ">
            {% if section.settings.button_banner != blank %}
            <a href="{{ section.settings.url_banner }}" class="button-shop button-shop-{{ section.id }}" title="">{{ section.settings.button_banner }}</a>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<style>
  .section-banner-v11 .button .button-shop-{{ section.id }} {
    color:{{ section.settings.color_btn }};
    border: 2px solid {{ section.settings.bg_btn }};
    background: {{ section.settings.bg_btn }};
  }
  .section-banner-v11 .button .button-shop-{{ section.id }}:hover {
    color:{{ section.settings.color_btn_hover }};
    background: {{ section.settings.bg_hover_btn }};
    border: 2px solid  {{ section.settings.bg_hover_btn }};
  }

</style>

