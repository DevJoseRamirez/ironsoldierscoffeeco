{% style %}
  #cwc_press-bar-{{ section.id }} {
    --section-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --text-color: {{ section.settings.text_color | default: '#6b7280' }};
    --highlight-color: {{ section.settings.bold_color | default: '#353b25' }};
    --border-color: {{ section.settings.border_color | default: '#ececec' }};
    --logo-height: {{ section.settings.logo_height | default: 30 }}px;
    --logo-height-mobile: {{ section.settings.logo_height | default: 30 | times: 0.75 }}px;
    --logo-gap: {{ section.settings.logo_gap | default: 100 }}px;
    --logo-gap-mobile: {{ section.settings.logo_gap_mobile | default: 20 }}px;
    --padding-top: {{ section.settings.padding_top | default: 20 }}px;
    --padding-bottom: {{ section.settings.padding_bottom | default: 20 }}px;
    --padding-top-mobile: {{ section.settings.padding_top | default: 20 | times: 0.5 }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom | default: 20 | times: 0.5 }}px;
  }
{% endstyle %}

{{ 'CWC_press_bar.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign logo_suffix = ''
  if section.settings.logo_style == 'white'
    assign logo_suffix = '_white'
  endif

  assign section_classes = 'cwc_press-bar'
  if section.settings.show_borders
    assign section_classes = section_classes | append: ' cwc_press-bar--bordered'
  endif
  if section.settings.label_position == 'above'
    assign section_classes = section_classes | append: ' cwc_press-bar--stacked'
  endif
  if section.settings.monochrome
    assign section_classes = section_classes | append: ' cwc_press-bar--mono'
  endif
-%}

<section id="cwc_press-bar-{{ section.id }}" class="{{ section_classes }}">
  <div class="cwc_press-bar__container">
    <div class="cwc_press-bar__wrapper">

      {% comment %} Label {% endcomment %}
      {% if section.settings.heading != blank %}
        <div class="cwc_press-bar__content-heading cwc-rte">
          {{ section.settings.heading }}
        </div>
      {% endif %}

      {% comment %} Logos {% endcomment %}
      {% if section.blocks.size > 0 %}
        <ul class="cwc_press-bar__logos" role="list">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'logo' %}
                {%- liquid
                  # Built-in logos: native size + visual balance scale (wide marks render shorter)
                  case block.settings.network
                    when 'fox'
                      assign logo_name = 'FOX'
                      assign logo_w = 185
                      assign logo_scale = 0.9
                    when 'nbc'
                      assign logo_name = 'NBC'
                      assign logo_w = 132
                      assign logo_scale = 1.0
                    when 'cbs'
                      assign logo_name = 'CBS'
                      assign logo_w = 277
                      assign logo_scale = 0.7
                    when 'cw'
                      assign logo_name = 'The CW'
                      assign logo_w = 182
                      assign logo_scale = 0.85
                    when 'abc'
                      assign logo_name = 'ABC'
                      assign logo_w = 79
                      assign logo_scale = 1.0
                    else
                      assign logo_name = ''
                      assign logo_w = 160
                      assign logo_scale = 1.0
                  endcase

                  assign logo_alt = block.settings.logo_alt
                  if logo_alt == blank and block.settings.logo != blank
                    assign logo_alt = block.settings.logo.alt
                  endif
                  if logo_alt == blank and logo_name != blank
                    assign logo_alt = 'Iron Soldiers Coffee featured on ' | append: logo_name
                  endif
                  assign size_adjust = block.settings.size_adjust | default: 100 | divided_by: 100.0
                  assign logo_scale = logo_scale | times: size_adjust
                -%}

                {%- capture logo_img -%}
                  {%- if block.settings.logo != blank -%}
                    {{ block.settings.logo | image_url: height: 160 | image_tag:
                      alt: logo_alt,
                      loading: 'lazy',
                      height: 80,
                      class: 'cwc_press-bar__logo-image'
                    }}
                  {%- elsif block.settings.network != 'custom' -%}
                    {%- assign logo_file = 'CWC_press_logo_' | append: block.settings.network | append: logo_suffix | append: '.png' -%}
                    <img
                      src="{{ logo_file | asset_url }}"
                      alt="{{ logo_alt | escape }}"
                      class="cwc_press-bar__logo-image"
                      width="{{ logo_w }}"
                      height="80"
                      loading="lazy"
                    >
                  {%- endif -%}
                {%- endcapture -%}

                {% if logo_img != blank %}
                  <li class="cwc_press-bar__logo" style="--logo-scale: {{ logo_scale }};" {{ block.shopify_attributes }}>
                    {% if block.settings.link != blank %}
                      <a
                        href="{{ block.settings.link }}"
                        class="cwc_press-bar__logo-link"
                        {% if block.settings.new_tab %}target="_blank" rel="noopener"{% endif %}
                      >
                        {{ logo_img }}
                      </a>
                    {% else %}
                      {{ logo_img }}
                    {% endif %}
                  </li>
                {% elsif request.design_mode %}
                  <li class="cwc_press-bar__logo" {{ block.shopify_attributes }}>
                    <span class="cwc_press-bar__placeholder">Add logo</span>
                  </li>
                {% endif %}
            {% endcase %}
          {% endfor %}
        </ul>
      {% elsif request.design_mode %}
        <div class="cwc_press-bar__empty">
          <p>Add logo blocks to display press features.</p>
        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "CWC Press Bar",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Label",
      "default": "<p>As Featured On</p>",
      "info": "Short label shown beside or above the logos. Only show networks where your feature actually ran."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "label_position",
      "label": "Label Position",
      "options": [
        { "value": "inline", "label": "Inline (left of logos)" },
        { "value": "above", "label": "Above logos" }
      ],
      "default": "inline"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Label Text Color",
      "default": "#6b7280"
    },
    {
      "type": "color",
      "id": "bold_color",
      "label": "Label Bold Color",
      "default": "#353b25"
    },
    {
      "type": "checkbox",
      "id": "show_borders",
      "label": "Show Top & Bottom Borders",
      "default": true
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#ececec"
    },
    {
      "type": "header",
      "content": "Logos"
    },
    {
      "type": "select",
      "id": "logo_style",
      "label": "Built-in Logo Style",
      "options": [
        { "value": "color", "label": "Color (light backgrounds)" },
        { "value": "white", "label": "White (dark backgrounds)" }
      ],
      "default": "color"
    },
    {
      "type": "checkbox",
      "id": "monochrome",
      "label": "Monochrome Logos",
      "info": "Shows logos in grayscale; full color on hover.",
      "default": false
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo Height",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "logo_gap",
      "label": "Space Between Logos (Desktop)",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "logo_gap_mobile",
      "label": "Space Between Logos (Mobile)",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "select",
          "id": "network",
          "label": "Network",
          "options": [
            { "value": "fox", "label": "FOX" },
            { "value": "nbc", "label": "NBC" },
            { "value": "cbs", "label": "CBS" },
            { "value": "cw", "label": "The CW" },
            { "value": "abc", "label": "ABC" },
            { "value": "custom", "label": "Custom (upload below)" }
          ],
          "default": "fox"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Custom Logo Image",
          "info": "Optional. Overrides the built-in network logo. Transparent PNG or SVG works best."
        },
        {
          "type": "text",
          "id": "logo_alt",
          "label": "Logo Alt Text",
          "info": "Describes the logo for screen readers and SEO. Defaults to \"Iron Soldiers Coffee featured on [Network]\"."
        },
        {
          "type": "range",
          "id": "size_adjust",
          "label": "Size Adjust",
          "min": 50,
          "max": 150,
          "step": 5,
          "unit": "%",
          "default": 100,
          "info": "Fine-tune so logos look visually balanced."
        },
        {
          "type": "header",
          "content": "Link"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Feature Link",
          "info": "Optional link to the article or placement."
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open Link in New Tab",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Press Bar",
      "category": "CWC Custom",
      "blocks": [
        { "type": "logo", "settings": { "network": "fox" } },
        { "type": "logo", "settings": { "network": "nbc" } },
        { "type": "logo", "settings": { "network": "cbs" } },
        { "type": "logo", "settings": { "network": "cw" } },
        { "type": "logo", "settings": { "network": "abc" } }
      ]
    }
  ]
}
{% endschema %}
