        "card_VPrXQc": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/449749429_10224856852385473_4962938254998189333_n.jpg",
            "image_link": "https://www.facebook.com/groups/457545080317295",
            "title": "<p><strong>Veterans Association of Whitesboro</strong><br/>Local Veteran Resource Group</p>",
            "text": "<p>A community-rooted nonprofit providing real resources and support to veterans in the Whitesboro area. Iron Soldiers Coffee Company is proud to support the work being done close to home for the men and women who served.</p>",
            "button_text": "Learn More",
            "button_link_2": "",
            "button_text_2": "Learn More"
          }
        },
        "card_DATczn": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/rs_w_700_cg_true_m.webp",
            "image_link": "https://hero2theline.org",
            "title": "<p><strong>Hero 2 The Line</strong><br/>Non-Profit | Service Dogs for Veterans & Gold Star Families</p>",
            "text": "<p>Hero 2 The Line provides trained lab puppies to veterans and Gold Star Families — offering the kind of unconditional support that helps with healing, independence, and daily life after service. A newer collaboration we're proud to grow.</p><p></p>",
            "button_text": "Learn More",
            "button_link_2": "",
            "button_text_2": "Learn More"
          }
        },
        "card_y6HJGY": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/Homepage_03-min.jpg",
            "image_link": "https://givingbackoutdoors.org",
            "title": "<p><strong>Giving Back Outdoors</strong><br/>Non-Profit | Veteran & Youth Hunts & Fishing Trips | Iowa</p>",
            "text": "<p>Erik Logsdon and the Giving Back Outdoors team organize hunts and fishing trips for veterans and their families — getting people back into nature, building community, and creating experiences that matter. We're proud to support their work out of Iowa.</p>",
            "button_text": "Learn More",
            "button_link_2": "",
            "button_text_2": "Learn More"
          }
        },
        "card_Ljcgg9": {
