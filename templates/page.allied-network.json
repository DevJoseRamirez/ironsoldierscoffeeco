        },
        "card_WHBaLE": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/logo_22.jpg",
            "image_link": "https://pownetwork.org/",
            "title": "<p><strong>POW Network</strong><br/>Veteran Advocacy | Branson, MO</p><p></p>",
            "text": "<p>The POW Network is dedicated to accounting for America's Prisoners of War and those Missing in Action. We support their annual Branson gathering and are proud to be part of an organization that ensures no veteran is ever forgotten.</p>",
            "button_text": "Learn More",
            "button_link_2": "",
            "button_text_2": "Learn More"
