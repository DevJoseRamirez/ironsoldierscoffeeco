        "text_color": "#111111",
        "bold_color": "#556a2f",
        "card_bg_color": "#f6f6f6",
        "button_bg_color": "#556a2f",
        "button_text_color": "#ffffff",
        "content_max_width": 900,
        "padding_top": 60,
        "padding_bottom": 60
      }
    },
