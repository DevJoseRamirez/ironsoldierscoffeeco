        "card_Y8NC47": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/DocSimsPortriatImage.png",
            "image_link": "https://www.amazon.com/Why-Heart-Purple-Matthew-Sims/dp/B0DRMP1BXM",
            "title": "<p><strong>Doc Sims Brew</strong></p><p>Collaboration Blend | Combat-Wounded Veteran & Author</p>",
            "text": "<p>Crafted in partnership with retired Master Sergeant and three-time Purple Heart recipient Matthew W. Sims — a mission-ready Honduran coffee honoring the warriors who carried the mission forward despite the cost. Fresh roasted, bold, and built to hold the line.</p>",
            "button_text": "Learn More",
            "button_link_2": "shopify://products/doc-sims-brew",
            "button_text_2": "Shop Now"
          }
        },
        "card_ntFbQF": {
          "type": "card",
          "settings": {
            "image": "shopify://shop_images/DF-LOGO-ALT_1.avif",
            "image_link": "https://documentaryfirst.com",
            "title": "<p><strong>Documentary First</strong><br/>Production Company | D-Day Blend Partner</p>",
            "text": "<p>The film production company behind the story that inspired our D-Day Blend. Documentary First brings history to life through powerful storytelling, and we're honored to have our coffee connected to their mission.</p>",
            "button_text": "Learn More",
            "button_link_2": "shopify://products/dany-s-d-day-blend",
            "button_text_2": "Shop Now"
          }
        }
      },
